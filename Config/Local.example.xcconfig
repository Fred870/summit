// Copy to Config/Local.xcconfig (git-ignored) and fill in.

// Xcode › Settings › Accounts › your Apple ID › Team ID (10 characters).
SUMMIT_TEAM_ID = ABCDE12345

// Supabase › Project Settings › API. Note the $() trick: xcconfig treats // as a comment.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key
